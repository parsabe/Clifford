# Kernel is reachable only through a private Unix socket. No shared access token.
CLIFFORD_SOCKET_PATH=/run/clifford/api.sock
CLIFFORD_USER_ID=owner
ASSISTANT_NAME=Clifford
WAKE_PHRASE=Clifford
DATABASE_URL=sqlite:///./data/clifford.db
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=gemma3:12b
OLLAMA_BASE_URL=http://127.0.0.1:11434
PROVIDER_TIMEOUT=180
PROVIDER_RETRIES=1
MAX_OUTPUT_TOKENS=512
CONTEXT_CHAR_BUDGET=4000
VOSK_MODEL_PATH=./data/models/vosk-model-small-en-us-0.15
FILES_ROOT=./data/files
REQUESTS_PER_MINUTE=60
# JSON array of operator-configured MCP servers. No email connection by default.
PLATFORM_SERVERS=[]
OLLAMA_NUM_CTX=2048

# Optional absolute path to the separate web-interface branch web/ directory.
WEB_ROOT=
