APP_NAME=Clifford
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clifford.parsabe.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Server-to-server connection only. Never put this token in browser JavaScript.
CLIFFORD_BACKEND_URL=http://127.0.0.1:8000
CLIFFORD_BACKEND_TOKEN=
CLIFFORD_BACKEND_TIMEOUT=240
# Set interactively with php artisan clifford:install. No paid model keys required.
CLIFFORD_WEB_PASSWORD_HASH=
